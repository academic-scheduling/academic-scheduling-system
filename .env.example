# Bu dosyayi .env olarak kopyala ve gercek degerleri gir.
# .env ASLA commit edilmez (.gitignore engelliyor).
#
# Asagidaki degerler GELISTIRME icindir; kopyaladiktan sonra degistirmeden
# calisir. Yayina cikarken degismesi gerekenler "YAYIN" notuyla isaretli.

DATABASE_URL=postgresql+psycopg://app:app_dev_password@localhost:5432/scheduling
SECRET_KEY=change-me-in-real-env
# Davet edilebilecek e-posta uzantilari. Bu SIZIN uygulama kuraliniz;
# mail sisteminin bir siniri degil. Alicinin Gmail'de mi Hotmail'de mi
# oldugu gonderim acisindan hicbir fark yaratmaz.
ALLOWED_EMAIL_DOMAINS=muh.example.edu.tr,gmail.com,hotmail.com,outlook.com

# --- E-posta ---
# Iki calisma modu var, ikisi de AYNI kodu kullanir (app/mailer.py):
#
# 1) GELISTIRME — Mailpit. Kimlik dogrulama ve TLS istemez, mail internete
#    hic cikmaz, http://localhost:8025 adresinden okunur. Asagidaki dort satir
#    bu moddadir; yerel gelistirmede boyle kalmali (her test kosusunda gercek
#    mail gondermek hem gereksiz hem kotayi yer).
#
# 2) YAYIN — gercek SMTP. Gmail ornegi (K-84):
#      SMTP_HOST=smtp.gmail.com
#      SMTP_PORT=587
#      SMTP_USER=projeadresi@gmail.com
#      SMTP_PASSWORD=<16 haneli UYGULAMA SIFRESI, bosluklar silinmis>
#      SMTP_STARTTLS=true
#      MAIL_FROM=projeadresi@gmail.com        <-- SMTP_USER ILE AYNI OLMALI
#
#    Uygulama sifresi nasil alinir: hesapta once 2 Adimli Dogrulama acilir
#    (Google Hesabi > Guvenlik), sonra ayni sayfadaki "Uygulama Sifreleri"nden
#    "Mail" icin bir sifre uretilir. Normal Gmail sifresi CALISMAZ.
#
#    MAIL_FROM neden SMTP_USER ile ayni olmali: Gmail, sahibi olmadiginiz bir
#    adresten gondermenize izin vermez. Sahibi olunmayan bir alan adindan
#    gondermeye calismak (ornegin @muh.example.edu.tr) alici tarafinda
#    SPF/DKIM denetiminden kalar ve mail dogrudan spam'e duser.
#
#    Kisisel hesap yerine proje icin ayri bir hesap acilmasi onerilir:
#    sifresi .env'e yaziliyor ve ekiple paylasiliyor.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false

INVITATION_EXPIRE_HOURS=168

# Sifre sifirlama linkinin omru (K-43). Davetten bilerek kisa: calinan bir
# sifirlama linki AKTIF hesabi dogrudan ele gecirir.
PASSWORD_RESET_EXPIRE_HOURS=2

# Ayni hesap icin saatte en fazla kac sifirlama maili gonderilir (K-44).
# Sinir asilirsa cevap DEGISMEZ, yalnizca mail gitmez.
PASSWORD_RESET_MAX_PER_HOUR=3

# --- Giris kaba kuvvet freni ---
# Basarisiz giris denemeleri sayilir; pencere icinde sinir dolunca parola HIC
# denenmeden 429 doner. YALNIZ basarisizliklar sayilir, yani normal kullanim
# kendi kendini kilitlemez.
#
# E-posta siniri bilerek GENIS tutulur: dar olsaydi biri baskasinin hesabini
# bilerek kilitleyebilirdi. Asil daralma IP tarafinda.
LOGIN_MAX_FAILURES_PER_EMAIL=10
LOGIN_MAX_FAILURES_PER_IP=30
LOGIN_FAILURE_WINDOW_MINUTES=15

# Google reCAPTCHA v2 GIZLI anahtari (K-44). Frontend'in
# VITE_RECAPTCHA_SITE_KEY'i ile CIFT halinde calisir.
#
# BOS BIRAKILIRSA dogrulama ATLANIR — yerel gelistirme ve testler internetsiz
# calisir. ENVIRONMENT=production iken bos birakilirsa uygulama ACILMAZ:
# public bir ucun korumasiz kalmasi sessizce gecistirilmemeli.
#
# Google'in herkese acik TEST gizli anahtari (her zaman gecer, yalniz deneme):
#   RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
RECAPTCHA_SECRET_KEY=

# Hoca import'unun cikabilecegi alan adlari (virgulle ayrilir). Detay
# sayfalarinin adresi liste sayfasindaki LINKLERDEN geliyor -- yani nereye
# istek atilacagini kaynak site soyluyor. Bu liste, sunucunun ic aglara ya da
# bulut metadata uclarina yonlendirilmesini engeller (SSRF).
# Alt alanlar kabul edilir: liste muhendislik.mu.edu.tr'de, detay
# www.mu.edu.tr'de durur.
LECTURER_IMPORT_ALLOWED_HOSTS=mu.edu.tr

# YAYIN: davet ve sifre sifirlama mailindeki linkler bu adresten uretilir.
FRONTEND_BASE_URL=http://localhost:5173
# YAYIN: gercek SMTP kullanilirken bu adres SMTP_USER ile ayni olmali
# (yukaridaki gerekce). Mailpit'te herhangi bir deger calisir.
MAIL_FROM=no-reply@muh.example.edu.tr

# --- Yayin ayarlari ---
# Tarayicinin API'yi cagirabilecegi kaynaklar (virgulle ayrilir).
# YAYIN: frontend'in gercek adresi yazilir.
CORS_ORIGINS=http://localhost:5173

# "production" yapildiginda uygulama, yukaridaki dev varsayilanlarindan
# herhangi biri kalmissa ACILMAYI REDDEDER (sessizce guvensiz calismasin).
ENVIRONMENT=development
