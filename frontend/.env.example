# Frontend derleme zamani degiskenleri.
# Bu dosyayi .env olarak kopyala. Vite yalniz VITE_ onekli degiskenleri yayar.
#
# GELISTIRME: bos birak. Tanimsizken uygulama "/api" kullanir ve
# vite.config.ts proxy'si istegi localhost:8000'e tasir.
#
# YAYIN: backend'in gercek kok adresi yazilir, ornegin
#   VITE_API_BASE_URL=https://api.ornek.edu.tr
# Deger derleme aninda gomulur; degistirince yeniden "npm run build" gerekir.
VITE_API_BASE_URL=

# Google reCAPTCHA v2 site anahtari (K-44) — sifre sifirlama formundaki
# "Ben robot degilim" kutusu.
#
# BOS BIRAKILIRSA: kutu hic cizilmez ve backend de dogrulamayi atlar
# (yerel gelistirme ve internetsiz demo bundan etkilenmez). Ikisi birlikte
# ayarlanmali: backend'de RECAPTCHA_SECRET_KEY, burada site anahtari.
#
# Anahtar cifti https://www.google.com/recaptcha/admin adresinden alinir
# (v2 "I'm not a robot" secilir, alan adi eklenir).
#
# Google'in HERKESE ACIK test anahtarlari (her zaman gecer, yalniz deneme icin):
#   VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
#   (backend tarafi: RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe)
VITE_RECAPTCHA_SITE_KEY=
