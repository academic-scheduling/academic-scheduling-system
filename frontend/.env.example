# Frontend derleme zamani degiskenleri.
# Bu dosyayi .env olarak kopyala. Vite yalniz VITE_ onekli degiskenleri yayar.
#
# GELISTIRME: bos birak. Tanimsizken uygulama "/api" kullanir ve
# vite.config.ts proxy'si istegi localhost:8000'e tasir.
#
# YAYIN: backend'in gercek kok adresi yazilir, ornegin
#   VITE_API_BASE_URL=https://api.ornek.edu.tr
# Deger derleme aninda gomulur; degistirince yeniden "npm run build" gerekir.
VITE_API_BASE_URL=
